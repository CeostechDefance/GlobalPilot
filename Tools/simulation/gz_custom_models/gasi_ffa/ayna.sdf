<?xml version="1.0"?>
<!-- make_mirror.py çıktısı: gasi_ffa modelinin su yansıması için ayna kopyası (yalnız görüntü) -->
<sdf version="1.9">
  <model name="ayna">
    <link name="link">
      <gravity>false</gravity>
      <kinematic>true</kinematic>
      <inertial><mass>0.001</mass><inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz></inertia></inertial>
      <visual name="body_visual">
        <pose>0.00000 0.00000 0.00000 0.000000 -0.000000 0.000000</pose>
        <geometry><mesh><uri>model://gasi_ffa/meshes/body.glb</uri><scale>1 1 -1</scale></mesh></geometry>
        <cast_shadows>false</cast_shadows>
      </visual>
      <visual name="nose_window_visual">
        <pose>0.00000 0.00000 0.00000 0.000000 -0.000000 0.000000</pose>
        <geometry><mesh><uri>model://gasi_ffa/meshes/nose_window.glb</uri><scale>1 1 -1</scale></mesh></geometry>
        <cast_shadows>false</cast_shadows>
      </visual>
      <visual name="left_aileron_visual">
        <pose>-0.95176 3.52793 -0.66173 0.000000 -0.000000 0.000000</pose>
        <geometry><mesh><uri>model://gasi_ffa/meshes/left_aileron.glb</uri><scale>1 1 -1</scale></mesh></geometry>
        <cast_shadows>false</cast_shadows>
      </visual>
      <visual name="right_aileron_visual">
        <pose>-0.95176 -3.52707 -0.66173 0.000000 -0.000000 0.000000</pose>
        <geometry><mesh><uri>model://gasi_ffa/meshes/right_aileron.glb</uri><scale>1 1 -1</scale></mesh></geometry>
        <cast_shadows>false</cast_shadows>
      </visual>
      <visual name="left_elevator_visual">
        <pose>-4.32350 0.81043 -1.68439 0.000000 -0.000000 0.000000</pose>
        <geometry><mesh><uri>model://gasi_ffa/meshes/left_elevator.glb</uri><scale>1 1 -1</scale></mesh></geometry>
        <cast_shadows>false</cast_shadows>
      </visual>
      <visual name="right_elevator_visual">
        <pose>-4.32350 -0.80957 -1.68289 0.000000 -0.000000 0.000000</pose>
        <geometry><mesh><uri>model://gasi_ffa/meshes/right_elevator.glb</uri><scale>1 1 -1</scale></mesh></geometry>
        <cast_shadows>false</cast_shadows>
      </visual>
      <visual name="rudder_visual">
        <pose>-4.14650 0.00043 -0.89389 0.000000 -0.000000 0.000000</pose>
        <geometry><mesh><uri>model://gasi_ffa/meshes/rudder.glb</uri><scale>1 1 -1</scale></mesh></geometry>
        <cast_shadows>false</cast_shadows>
      </visual>
      <visual name="left_flap_visual">
        <pose>-0.87626 1.93793 -0.58013 0.000000 -0.000000 0.000000</pose>
        <geometry><mesh><uri>model://gasi_ffa/meshes/left_flap.glb</uri><scale>1 1 -1</scale></mesh></geometry>
        <cast_shadows>false</cast_shadows>
      </visual>
      <visual name="right_flap_visual">
        <pose>-0.87626 -1.93707 -0.58013 0.000000 -0.000000 0.000000</pose>
        <geometry><mesh><uri>model://gasi_ffa/meshes/right_flap.glb</uri><scale>1 1 -1</scale></mesh></geometry>
        <cast_shadows>false</cast_shadows>
      </visual>
      <visual name="prop_visual">
        <pose>-1.69350 0.00043 -0.90439 0.000000 0.000000 0.000000</pose>
        <geometry><mesh><uri>model://gasi_ffa/meshes/prop.glb</uri><scale>1 1 -1</scale></mesh></geometry>
        <cast_shadows>false</cast_shadows>
      </visual>
    </link>
  </model>
</sdf>
